# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core runtime ---
NODE_ENV=development
PORT=3000

# --- Database (required) ---
DATABASE_URL=mysql://user:password@localhost:3306/hasaad_dev

# --- Better Auth (required) ---
# 32+ char random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public origin the app is served from. Must NOT be localhost in production.
BETTER_AUTH_URL=http://localhost:3000
# Falls back to BETTER_AUTH_URL if unset; also used by the client build.
VITE_APP_URL=http://localhost:3000

# Bootstraps the first admin account (must sign up with a verified email matching this).
INITIAL_ADMIN_EMAIL=admin@example.com

# --- Google OAuth (optional — leave both empty to disable, or set both) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AWS S3 storage (required — image/file uploads depend on it) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-with-your-bucket-name
# Optional: only needed if not using an attached IAM role/instance profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Reverse proxy (optional) ---
# Set when running behind a reverse proxy/load balancer: "true", "false", a hop count
# like "1", or a specific proxy IP/CIDR. Defaults to 1 in production, false in dev.
TRUST_PROXY=

# --- Client-side (optional) ---
VITE_GOOGLE_MAPS_API_KEY=
